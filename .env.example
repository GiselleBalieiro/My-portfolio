# Producao (configure estas na Vercel)

# Rota de login (POST /user) - projeto ia-rag-api
VITE_AUTH_API_URL=https://ia-rag-api.vercel.app

# API de conteudo - projeto portfolio-api
VITE_CONTENT_API_URL=https://portfolio-api.vercel.app

# No desenvolvimento local use .env.development.local:
#   VITE_AUTH_API_URL=/auth-api            (passa pelo proxy do Vite)
#   VITE_CONTENT_API_URL=http://localhost:3334
